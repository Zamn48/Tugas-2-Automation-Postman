          "name": "POST Tambah Rute Bus",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code 201\", function () {\r\n    pm.response.to.have.status(201);\r\n});\r\n\r\npm.test(\"Rute bus berhasil ditambahkan\", function () {\r\n    const json = pm.response.json();\r\n    pm.expect(json.status).to.eql(\"success\");\r\n    pm.expect(json.data.kodeRute).to.eql(\"K4\");\r\n    pm.expect(json.data.tarif).to.eql(5000);\r\n});\r\n\r\nconst json = pm.response.json();\r\n\r\nif (json.data && json.data.id !== undefined) {\r\n    pm.collectionVariables.set(\"busRouteId\", json.data.id);\r\n}"
                ]
              }
            }
