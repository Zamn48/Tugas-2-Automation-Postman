        {
          "name": "GET Rute Bus Berdasarkan Kota",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "\r\npm.test(\"Status code 200\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\npm.test(\"Data rute bus sesuai kota Palembang\", function () {\r\n    const json = pm.response.json();\r\n\r\n    pm.expect(json).to.be.an(\"array\");\r\n    pm.expect(json.length).to.be.greaterThan(0);\r\n\r\n    json.forEach(function (rute) {\r\n        pm.expect(rute.kota).to.eql(\"Palembang\");\r\n    });\r\n});\r\n"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "x-api-key",
                "value": "{{x-api-key}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\r\n  \"kodeRute\": \"K6\",\r\n  \"asal\": \"Plaju\",\r\n  \"tujuan\": \"Ampera\",\r\n  \"kota\": \"Palembang\",\r\n  \"tarif\": \"lima ribu\"\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/bus-routes?kota=Palembang",
